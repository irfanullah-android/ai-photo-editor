<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#191919"
    android:orientation="vertical">


    <!-- Top intensity / text size slider alone -->
    <LinearLayout
        android:id="@+id/intensityContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#191919"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <SeekBar
            android:id="@+id/sbTextIntensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progressBackgroundTint="#3A3A3A"
            android:progressTint="@android:color/white"
            android:thumbTint="@android:color/white" />
    </LinearLayout>

    <!-- Tools bar with + Add Text capsule at start followed by rvTools -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#1F1F1F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTextCapsule"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+ Add Text"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:backgroundTint="#3D8BFF"
            app:cornerRadius="18dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- Selected tool ka panel yahan swap hota hai -->
    <FrameLayout
        android:id="@+id/toolContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141414"
        android:minHeight="64dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp" />

</LinearLayout>