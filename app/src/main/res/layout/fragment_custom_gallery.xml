<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.childfragments.CustomGalleryFragments">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@color/app_color">


    <!-- TOP BAR -->
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_cross"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/llAlbumDropdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dropdown_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAlbumName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Photos"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_camera_white"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <!-- DIVIDER -->
        <!-- DIVIDER -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#1A2A3A"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/llAlbumDropdown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PHOTO GRID -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPhotoGrid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toTopOf="@id/bottomPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintHeight_min="200dp"/>

        <!-- BOTTOM PANEL -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D1B2A"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- "3 free uses available" -->
            <TextView
                android:id="@+id/tvFreeUses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 free uses available"
                android:textColor="#8899AA"
                android:textSize="12sp"
                android:paddingBottom="8dp"/>

            <!-- Select label row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSelectLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select 2 photos"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/tvSelectCount"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:text="2"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_accent"
                    android:layout_marginStart="6dp"
                    app:layout_constraintStart_toEndOf="@id/tvSelectLabel"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <ImageView
                    android:id="@+id/ivInfo"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_info"
                    android:layout_marginEnd="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnConfirm"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Confirm"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_btn_confirm"
                    android:paddingHorizontal="14dp"
                    android:enabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Selected Photo Previews -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <!-- Person 1 -->
                <FrameLayout
                    android:id="@+id/flPerson1"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/ivPerson1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_photo_placeholder"/>

                    <ImageView
                        android:id="@+id/ivRemove1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="2dp"
                        app:tint="@color/black"
                        android:background="@drawable/bg_circle_accent"
                        android:src="@drawable/ic_cross"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Person 2 -->
                <FrameLayout
                    android:id="@+id/flPerson2"
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <ImageView
                        android:id="@+id/ivPerson2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_photo_placeholder"/>

                    <ImageView
                        android:id="@+id/ivRemove2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="2dp"
                        android:padding="2dp"
                        android:background="@drawable/bg_circle_accent"
                        android:src="@drawable/ic_cross"
                        android:elevation="10dp"
                        android:visibility="gone"
                        app:tint="@color/black" />

                </FrameLayout>

            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>