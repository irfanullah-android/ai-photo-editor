<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">
    <!-- Drag Handle Pill -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />
    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp">
        <!-- Left Actions Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- Undo -->
            <ImageView
                android:id="@+id/btnUndo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_undo"
                app:tint="@android:color/white" />
            <!-- Redo -->
            <ImageView
                android:id="@+id/btnRedo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_redo"
                app:tint="@android:color/white" />
        </LinearLayout>
        <!-- Center Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Doodle"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
        <!-- Right Actions Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- Reverse / Reset -->
            <ImageView
                android:id="@+id/btnReverse"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_back_orignial"
                app:tint="@android:color/white" />
            <!-- Apply / Check -->
            <ImageView
                android:id="@+id/btnApply"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white" />
        </LinearLayout>
    </RelativeLayout>
    <!-- Sliders and Live Preview Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <!-- Live Brush Preview Container -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_preview_container">
            <View
                android:id="@+id/viewBrushPreview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center" />
        </FrameLayout>
        <!-- Color and Size Controls Stack -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <!-- Color Slider Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <SeekBar
                    android:id="@+id/seekBarColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="360"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progressDrawable="@drawable/seekbar_color_gradient"
                    android:thumb="@drawable/seekbar_thumb" />
            </LinearLayout>
            <!-- Brush Size Slider Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/txtBrushSize"
                    android:layout_width="45dp"
                    android:layout_height="wrap_content"
                    android:text="25"
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <SeekBar
                    android:id="@+id/seekBarBrushSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="25"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:progressDrawable="@drawable/seekbar_size_progress"
                    android:thumb="@drawable/seekbar_thumb" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- Brush Selection Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- Eraser Button -->
        <ImageView
            android:id="@+id/btnEraser"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:padding="12dp"
            android:background="@drawable/bg_brush_item"
            android:src="@drawable/ic_eraser"
            app:tint="@android:color/white" />
        <!-- Brush Types Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBrushTypes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</LinearLayout>
