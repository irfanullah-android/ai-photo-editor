<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.mainfragment.MainFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_color">

        <!-- NAV HOST -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fcv_container_Navigation"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <!-- BOTTOM NAV -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_bottom_dark"
            app:itemIconSize="22dp"
            app:itemTextColor="@color/nav_color_selector"
            app:itemIconTint="@color/nav_color_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nev_menu"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- DARK ROUNDED-SQUARE BACKGROUND (FLOATING ON TOP EDGE OF NAV) -->
        <ImageView
            android:id="@+id/ivCameraBg"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginBottom="-35dp"
            android:elevation="22dp"
            android:src="@drawable/camera_background"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- CENTER CAMERA ICON -->
        <ImageView
            android:id="@+id/ivCenterCamera"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_camra_pink"
            android:elevation="24dp"
            app:layout_constraintTop_toTopOf="@id/ivCameraBg"
            app:layout_constraintBottom_toBottomOf="@id/ivCameraBg"
            app:layout_constraintStart_toStartOf="@id/ivCameraBg"
            app:layout_constraintEnd_toEndOf="@id/ivCameraBg" />

        <!-- INDICATOR LINE -->
        <View
            android:id="@+id/indicatorLine"
            android:layout_width="22dp"
            android:layout_height="3dp"
            android:layout_marginBottom="1dp"
            android:background="@color/theme_violet"
            android:elevation="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>