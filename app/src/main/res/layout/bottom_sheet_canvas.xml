<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle"
        android:alpha="0.5" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Canvas"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <ImageButton
            android:id="@+id/btnCheck"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_check"
            app:tint="@android:color/white"
            android:contentDescription="Apply" />

    </RelativeLayout>

    <!-- Zoom Control Card -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="2dp"
        android:text="Zoom"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_control_card"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/btnFlipLeft"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:src="@drawable/ic_flip_horizontal"
            android:background="@drawable/bg_circle_ripple"
            app:tint="@android:color/white"
            android:contentDescription="Flip horizontal" />

        <ImageView
            android:id="@+id/btnFlipUp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_flip_vertical"
            android:background="@drawable/bg_circle_ripple"
            app:tint="@android:color/white"
            android:contentDescription="Flip vertical" />

        <SeekBar
            android:id="@+id/seekBarZoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/white"
            android:thumbTint="@color/white" />

        <ImageView
            android:id="@+id/btnZoomIn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:src="@drawable/ic_zoom_in"
            android:background="@drawable/bg_circle_ripple"
            app:tint="@android:color/white"
            android:contentDescription="Zoom in" />

    </LinearLayout>

    <!-- Aspect Ratio Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="2dp"
        android:text="Aspect Ratio"
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAspectRatios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>