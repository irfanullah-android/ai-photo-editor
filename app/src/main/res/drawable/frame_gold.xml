<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFD700"
                android:centerColor="#FFC107"
                android:endColor="#FFB300"
                android:type="linear"/>
        </shape>
    </item>
    <item android:top="5dp" android:left="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFEB3B"
                android:centerColor="#FFC107"
                android:endColor="#FF8F00"
                android:type="linear"/>
        </shape>
    </item>
    <item android:top="38dp" android:bottom="38dp"
        android:left="38dp" android:right="38dp">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#B8860B"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:top="43dp" android:bottom="43dp"
        android:left="43dp" android:right="43dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#DAA520"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:top="47dp" android:bottom="47dp"
        android:left="47dp" android:right="47dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFD700"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:top="52dp" android:bottom="52dp"
        android:left="52dp" android:right="52dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
