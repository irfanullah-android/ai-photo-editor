<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#654321"
                android:centerColor="#8B4513"
                android:endColor="#654321"
                android:type="linear"/>
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp"
        android:left="5dp" android:right="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#5C4033"
                android:centerColor="#704214"
                android:endColor="#5C4033"
                android:type="linear"/>
        </shape>
    </item>
    <item android:top="35dp" android:bottom="35dp"
        android:left="35dp" android:right="35dp">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#3E2723"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:top="40dp" android:bottom="40dp"
        android:left="40dp" android:right="40dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#A0826D"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:top="45dp" android:bottom="45dp"
        android:left="45dp" android:right="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>