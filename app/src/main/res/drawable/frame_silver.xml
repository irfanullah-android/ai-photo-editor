<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E8E8E8"
                android:centerColor="#C0C0C0"
                android:endColor="#A8A8A8"
                android:type="linear"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="3dp" android:left="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#F5F5F5"
                android:centerColor="#D3D3D3"
                android:endColor="#B0B0B0"
                android:type="linear"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="32dp" android:bottom="32dp"
        android:left="32dp" android:right="32dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#909090"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="36dp" android:bottom="36dp"
        android:left="36dp" android:right="36dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#C0C0C0"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="40dp" android:bottom="40dp"
        android:left="40dp" android:right="40dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#E8E8E8"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="45dp" android:bottom="45dp"
        android:left="45dp" android:right="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>