<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#708090"
                android:centerColor="#4A5568"
                android:endColor="#2D3748"
                android:type="linear"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="3dp" android:left="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#B0BEC5"
                android:centerColor="#78909C"
                android:endColor="#546E7A"
                android:type="linear"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="30dp" android:bottom="30dp"
        android:left="30dp" android:right="30dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#37474F"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="33dp" android:bottom="33dp"
        android:left="33dp" android:right="33dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#90A4AE"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="38dp" android:bottom="38dp"
        android:left="38dp" android:right="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>