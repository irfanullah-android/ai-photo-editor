<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
        </shape>
    </item>
    <item android:top="8dp" android:left="25dp" android:right="25dp" android:bottom="-20dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
        </shape>
    </item>
    <item android:bottom="8dp" android:left="25dp" android:right="25dp" android:top="-20dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
        </shape>
    </item>
    <item android:top="40dp" android:bottom="40dp"
        android:left="40dp" android:right="40dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#333333"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>
    <item android:top="45dp" android:bottom="45dp"
        android:left="45dp" android:right="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>