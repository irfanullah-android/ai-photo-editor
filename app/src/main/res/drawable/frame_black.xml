<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:top="4dp" android:bottom="4dp"
        android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A1A1A"
                android:centerColor="#0D0D0D"
                android:endColor="#000000"
                android:type="linear"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="28dp" android:bottom="28dp"
        android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1A1A1A"/>
            <solid android:color="#00000000"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="32dp" android:bottom="32dp"
        android:left="32dp" android:right="32dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#333333"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="36dp" android:bottom="36dp"
        android:left="36dp" android:right="36dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>