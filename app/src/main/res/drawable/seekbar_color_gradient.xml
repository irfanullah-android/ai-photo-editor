<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="12dp" />
            <corners android:radius="6dp" />
            <gradient
                android:angle="0"
                android:type="linear">
                <item android:color="#FF0000" android:offset="0.0" />
                <item android:color="#FFFF00" android:offset="0.167" />
                <item android:color="#00FF00" android:offset="0.333" />
                <item android:color="#00FFFF" android:offset="0.5" />
                <item android:color="#0000FF" android:offset="0.667" />
                <item android:color="#FF00FF" android:offset="0.833" />
                <item android:color="#FF0000" android:offset="1.0" />
            </gradient>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="12dp" />
                <corners android:radius="6dp" />
                <gradient
                    android:angle="0"
                    android:type="linear">
                    <item android:color="#FF0000" android:offset="0.0" />
                    <item android:color="#FFFF00" android:offset="0.167" />
                    <item android:color="#00FF00" android:offset="0.333" />
                    <item android:color="#00FFFF" android:offset="0.5" />
                    <item android:color="#0000FF" android:offset="0.667" />
                    <item android:color="#FF00FF" android:offset="0.833" />
                    <item android:color="#FF0000" android:offset="1.0" />
                </gradient>
            </shape>
        </clip>
    </item>
</layer-list>