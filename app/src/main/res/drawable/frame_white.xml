<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5F5F5"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:top="4dp" android:bottom="4dp"
        android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFFFFF"
                android:centerColor="#FAFAFA"
                android:endColor="#F5F5F5"
                android:type="linear"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="30dp" android:bottom="30dp"
        android:left="30dp" android:right="30dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#E0E0E0"/>
            <solid android:color="#00000000"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="34dp" android:bottom="34dp"
        android:left="34dp" android:right="34dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#EEEEEE"/>
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <item android:top="38dp" android:bottom="38dp"
        android:left="38dp" android:right="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>