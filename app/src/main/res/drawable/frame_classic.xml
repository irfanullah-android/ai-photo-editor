<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer wood border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#8B4513"
                android:centerColor="#A0522D"
                android:endColor="#8B4513"
                android:type="linear"/>
        </shape>
    </item>

    <!-- Inner shadow -->
    <item android:top="35dp" android:bottom="35dp"
        android:left="35dp" android:right="35dp">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#654321"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>

    <!-- Inner gold accent -->
    <item android:top="38dp" android:bottom="38dp"
        android:left="38dp" android:right="38dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#DAA520"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>

    <!-- Image area -->
    <item android:top="45dp" android:bottom="45dp"
        android:left="45dp" android:right="45dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>