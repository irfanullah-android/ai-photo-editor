<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1C1C"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:top="25dp" android:bottom="25dp"
        android:left="25dp" android:right="25dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#404040"/>
            <solid android:color="#00000000"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="28dp" android:bottom="28dp"
        android:left="28dp" android:right="28dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <solid android:color="#00000000"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:top="32dp" android:bottom="32dp"
        android:left="32dp" android:right="32dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>